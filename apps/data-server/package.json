    "@graphile/federation": "~0.1.0",
    "koa": "~2.13.4",
    "joi": "~17.6.0",
    "@graphile-contrib/pg-order-by-related": "~1.0.0-beta.6"
  },
  "devDependencies": {
    "typescript": "~4.7.4",
    "@lani/cli": "workspace:~1.0.0",
    "typescript-transform-paths": "~3.5.6",
