{
  "folders": [
    {
      "name": "✨ root",
      "path": "."
    },
    {
      "name": "📦 @lani/framework",
      "path": "libs/framework"
    },
    {
      "name": "📦 @lani/parse-torrent-title",
      "path": "libs/parse-torrent-title"
    },
    {
      "name": "💾 @lani/db",
      "path": "libs/db"
    },
    {
      "name": "⚙️ @lani/cli",
      "path": "tools/cli"
    },
    {
      "name": "🚀 @lani/data-server",
      "path": "apps/data-server"
    },
    {
      "name": "🚀 @lani/admin",
      "path": "apps/admin"
    },
    {
      "name": "🚀 @lani/api-server",
      "path": "apps/api-server"
    },
    {
      "name": "🚀 @lani/gateway",
      "path": "apps/gateway"
    },
    {
      "name": "🚚 @lani/all-in-one",
      "path": "apps/all-in-one"
    },
    {
      "name": "📖 @lani/docs",
      "path": "docs"
    }
  ],
  "settings": {
    "files.associations": {
      "rush.json": "jsonc",
      "**/common/config/rush/*.json": "jsonc",
      "**/manifests/**/*.yaml.hbs": "yaml"
    },
    "json.schemas": [
      {
        "fileMatch": ["**/laniconf.json"],
        "url": "../../tools/cli/dist/schema/laniconf.schema.json"
      }
    ],
    "typescript.tsdk": "📦 @lani/framework/node_modules/typescript/lib",
    "workbench.colorCustomizations": {
      "activityBar.activeBackground": "#2f7c47",
      "activityBar.background": "#2f7c47",
      "activityBar.foreground": "#e7e7e7",
      "activityBar.inactiveForeground": "#e7e7e799",
      "activityBarBadge.background": "#422c74",
      "activityBarBadge.foreground": "#e7e7e7",
      "commandCenter.border": "#e7e7e799",
      "sash.hoverBorder": "#2f7c47",
      "statusBar.background": "#215732",
      "statusBar.foreground": "#e7e7e7",
      "statusBarItem.hoverBackground": "#2f7c47",
      "statusBarItem.remoteBackground": "#215732",
      "statusBarItem.remoteForeground": "#e7e7e7",
      "titleBar.activeBackground": "#215732",
      "titleBar.activeForeground": "#e7e7e7",
      "titleBar.inactiveBackground": "#21573299",
      "titleBar.inactiveForeground": "#e7e7e799"
    },
    "peacock.remoteColor": "#215732"
  },
  "extensions": {
    "recommendations": [
      "esbenp.prettier-vscode",
      "redhat.vscode-yaml",
      "eamodio.gitlens",
      "ms-kubernetes-tools.vscode-kubernetes-tools",
      "folke.vscode-monorepo-workspace"
    ]
  }
}
